 import { spawnSync } from "node:child_process";
+import { basename } from "node:path";
 
 const MACOS_LOGIN_SHELL = "/bin/zsh";
+const NON_POSIX_SHELL_NAMES = new Set([
+  "elvish",
+  "fish",
+  "nu",
+  "nushell",
+  "pwsh",
+  "xonsh",
+]);
 const SHELL_PATH_COMMAND = 'printf "%s" "$PATH"';
 const SHELL_PATH_TIMEOUT_MS = 2_000;
 
@@ -71,6 +80,23 @@
   };
 }
 
+function resolveLoginShell(
+  env: NodeJS.ProcessEnv,
+  platform: NodeJS.Platform,
+): string {
+  if (platform === "darwin") {
+    return MACOS_LOGIN_SHELL;
+  }
+  const configuredShell = env.SHELL?.trim();
+  if (
+    configuredShell !== undefined &&
+    !NON_POSIX_SHELL_NAMES.has(basename(configuredShell))
+  ) {
+    return configuredShell;
+  }
+  return "/bin/sh";
+}
